# Development environment. Committed template — no real secrets.
# Values here are used when .env.local does not define them.
NODE_ENV=development
APP_NAME=Workforce
APP_URL=https://emptrack.bsctextiles.in
FRONTEND_URL=https://emptrack.bsctextiles.in
BACKEND_URL=http://localhost:4000
APP_ORIGIN=https://emptrack.bsctextiles.in,http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
PORT=4000
LOG_LEVEL=debug

# Hostinger SMTP verified configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@bsctextiles.in
SMTP_PASSWORD=Btpldvg@2026
SMTP_FROM_NAME=BSC Textiles Workforce
SMTP_FROM_EMAIL=admin@bsctextiles.in
SMTP_FROM=BSC Textiles Workforce <admin@bsctextiles.in>
SMTP_REPLY_TO=admin@bsctextiles.in

# Seeded demo accounts only. Disable the login helper with TEST_LOGIN_ENABLED=false.
TEST_LOGIN_ENABLED=true
TEST_LOGIN_PASSWORD=Workforce@2026

# Optional integrations for local work.
REDIS_URL=
WEBSOCKET_URL=
STORAGE_PROVIDER=local
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=15
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=600
