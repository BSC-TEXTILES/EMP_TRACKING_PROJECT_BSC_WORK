# Frontend build-time configuration. Never place secrets in VITE_* variables:
# every value here is embedded in the client bundle.
# The API is served from the same origin by default; leave unset unless the
# frontend is hosted separately.
# VITE_API_BASE=https://workforce.example.com/api
# Optional explicit Socket.IO endpoint (defaults to the current origin).
# VITE_WEBSOCKET_URL=wss://workforce.example.com
# Dev server only: backend the Vite proxy forwards /api and /socket.io to.
# VITE_API_PROXY=http://localhost:4000
VITE_APP_NAME=Workforce
VITE_ENVIRONMENT_LABEL=Development
