# ---------------------------------------------------------------------------
# Production environment template.
# Keep the real `.env.production` on the server only (chmod 600, owned by the
# application user), or inject the same names through your secret manager.
# ---------------------------------------------------------------------------

NODE_ENV=production
APP_NAME=Workforce
APP_URL=https://emptrack.bsctextiles.in
FRONTEND_URL=https://emptrack.bsctextiles.in
BACKEND_URL=https://emptrack.bsctextiles.in
APP_ORIGIN=https://emptrack.bsctextiles.in
APP_TIMEZONE=Asia/Kolkata
PORT=4000
LOG_LEVEL=info

# Enter database, SMTP and first-administrator details at /setup.
# No database/SMTP passwords or placeholder credentials are needed here.
WEB_SETUP_ENABLED=true
WORKFORCE_CONFIG_DIR=/srv/workforce/private-config
DB_POOL_SIZE=20

# Optional external secret-manager keys. If omitted, the server creates an
# owner-only master.key and derives its signing key. Back this up securely.
# ENCRYPTION_MASTER_KEY=<64 hex characters>
# JWT_SECRET=<independent signing secret>

SESSION_TTL_DAYS=7

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=600

STORAGE_PROVIDER=local
UPLOAD_DIR=/srv/workforce/storage
MAX_UPLOAD_MB=15

# Optional TURN service; leave empty until a real provider is configured.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Fail-closed upload scanning; private network only
CLAMAV_HOST=
CLAMAV_PORT=3310
# Set loopback only when NGINX runs on the same host
TRUST_PROXY=loopback

# Default API binding is private to this host
BIND_HOST=127.0.0.1

# Demo login helper must never be enabled in production.
TEST_LOGIN_ENABLED=false
