# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_NAME=Workforce
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
APP_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# MySQL connection (DATABASE_URL takes precedence when set)
# ---------------------------------------------------------------------------
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/emp_tracking
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=emp_tracking
DB_USER=root
DB_PASSWORD=change-me
DB_POOL_SIZE=12

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-64-character-random-string
JWT_REFRESH_SECRET=unused-placeholder-reserved-for-refresh-tokens
SESSION_SECRET=replace-with-another-random-string
COOKIE_SECRET=replace-with-another-random-string
INTERNAL_JOB_SECRET=replace-with-a-random-string
SESSION_TTL_DAYS=7

# ---------------------------------------------------------------------------
# OTP
# ---------------------------------------------------------------------------
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Notification/mailbox email master switch. OFF unless set to true. When off nothing is
# sent (messages are recorded as "skipped"); only login and password-reset codes are emailed.
EMAIL_SENDING_ENABLED=false
# Show login/reset codes on screen. Development servers only; ignored in production.
# OTP_SHOW_CODES_ON_SCREEN=false

# SMTP (email OTP + notifications). Empty SMTP_HOST disables delivery.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Workforce
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_REPLY_TO=

# ---------------------------------------------------------------------------
# SMS OTP provider (generic HTTP gateway). Empty = disabled.
# ---------------------------------------------------------------------------
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
SMS_SENDER_ID=WORKFR

# ---------------------------------------------------------------------------
# Optional WebRTC TURN server
# ---------------------------------------------------------------------------
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Calling: ring time before a call becomes "missed" (15-120 s), time to wait for any device of the
# callee to confirm the ring before "User is offline or unreachable" (5 s .. ring time - 3), and how
# long a participant whose network dropped may take to rejoin before the call is ended.
CALL_RING_TIMEOUT_SECONDS=30
CALL_UNREACHABLE_SECONDS=12
CALL_RECONNECT_GRACE_SECONDS=20

# Web Push (VAPID) for the website / installed PWA: incoming-call ringing and chat alerts
# while the app is closed. Generate ONCE with: npx web-push generate-vapid-keys
# and never change them (a new key silently invalidates every phone's subscription).
# If empty, keys are generated into backend/storage/config/vapid.json, which must survive redeploys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Optional Redis and websocket overrides
# ---------------------------------------------------------------------------
REDIS_URL=
WEBSOCKET_URL=

# ---------------------------------------------------------------------------
# File storage and rate limiting
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=15
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=600
LOGIN_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# Reserved integrations and upload scanning
# ---------------------------------------------------------------------------
MEETING_PROVIDER=builtin
MEETING_API_KEY=
MEETING_API_SECRET=
CLAMAV_HOST=
CLAMAV_PORT=3310
# Optional virus scanning. Uploads are always content-verified; with CLAMAV_HOST set they are
# also ClamAV-scanned. UPLOAD_SCAN_MODE=required refuses uploads when no scanner is configured.
UPLOAD_SCAN_MODE=when_available
TRUST_PROXY=
BIND_HOST=127.0.0.1

# Coarena Model API (server only; obtain a real key at https://coarena.ai)
COARENA_API_KEY=
COARENA_MODEL=gpt-6-luna
COARENA_TIMEOUT_MS=60000

# Demo login helper (development only; ignored in production)
TEST_LOGIN_ENABLED=true
TEST_LOGIN_PASSWORD=Workforce@2026

# Website-managed configuration
WEB_SETUP_ENABLED=false
# WORKFORCE_CONFIG_DIR=storage/config
# ENCRYPTION_MASTER_KEY=<64 hex characters>

# Mobile app (Android / iOS)
# Firebase service account for push to phones (Firebase console > Project settings >
# Service accounts > Generate new private key). Server-side only; never put it in the app.
# Give either a file path or the JSON itself (raw or base64). Leave both empty to disable.
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=
# Origins the Capacitor app runs on. Allowed for Bearer-token requests without cookies only.
MOBILE_APP_ORIGINS=capacitor://localhost,https://localhost

# Activity tracking: path of the Windows agent installer served at /api/tracking/agent/download
# (default: tracking-agent/dist/BSC-Activity-Tracker-Setup.exe)
TRACKING_AGENT_INSTALLER=
