# Apache standalone configuration reference (for Apache without Hostinger Node.js Web App)
DirectoryIndex index.html index.htm index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing physical files directly (CSS, JS, images, icons, index.html)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Route all other client routes to index.html for SPA
  RewriteCond %{REQUEST_URI} !^/api
  RewriteCond %{REQUEST_URI} !^/socket\.io
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
