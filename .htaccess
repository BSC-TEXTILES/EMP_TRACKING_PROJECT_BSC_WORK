# Root Apache / LiteSpeed configuration for Hostinger / cPanel
DirectoryIndex index.html index.htm index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Proxy API and WebSocket requests to local Node.js backend if running
  <IfModule mod_proxy.c>
    RewriteRule ^api/(.*)$ http://127.0.0.1:4000/api/$1 [P,L]
    RewriteRule ^api$ http://127.0.0.1:4000/api/ [P,L]
    RewriteRule ^socket\.io/(.*)$ http://127.0.0.1:4000/socket.io/$1 [P,L]
  </IfModule>

  # 2. If frontend/dist exists, route web traffic to it
  RewriteCond %{DOCUMENT_ROOT}/frontend/dist/$1 -f
  RewriteRule ^(.*)$ frontend/dist/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/frontend/dist/index.html -f
  RewriteRule ^$ frontend/dist/index.html [L]

  # 3. Route all client SPA routes to frontend/dist/index.html if available
  RewriteCond %{DOCUMENT_ROOT}/frontend/dist/index.html -f
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !^/api
  RewriteCond %{REQUEST_URI} !^/socket\.io
  RewriteRule ^(.*)$ frontend/dist/index.html [L]
</IfModule>

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
