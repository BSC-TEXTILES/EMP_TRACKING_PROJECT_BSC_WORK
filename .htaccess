# Enable LiteSpeed Passenger for Node.js applications on Hostinger
<IfModule Litespeed>
  PassengerEngine on
  PassengerAppType node
  PassengerStartupFile server.js
</IfModule>

DirectoryIndex index.html index.htm index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. If frontend/dist exists, route web traffic to it
  RewriteCond %{DOCUMENT_ROOT}/frontend/dist/$1 -f
  RewriteRule ^(.*)$ frontend/dist/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/frontend/dist/index.html -f
  RewriteRule ^$ frontend/dist/index.html [L]

  # 2. Route all client SPA routes to frontend/dist/index.html if available
  RewriteCond %{DOCUMENT_ROOT}/frontend/dist/index.html -f
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !^/api
  RewriteCond %{REQUEST_URI} !^/socket\.io
  RewriteRule ^(.*)$ frontend/dist/index.html [L]
</IfModule>

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
