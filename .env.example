# ---------------------------------------------------------------------------
# Workforce — environment template
# Copy to `.env.local` (development) or `.env.production` (server).
# NEVER commit a real environment file. Only this template is tracked.
# ---------------------------------------------------------------------------

# ------------------------------- APPLICATION -------------------------------
NODE_ENV=development
APP_NAME=Workforce
APP_URL=http://localhost:5173            # public URL used in emails and links
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
APP_ORIGIN=http://localhost:5173         # allowed browser origins (comma separated)
APP_TIMEZONE=Asia/Kolkata
PORT=4000
LOG_LEVEL=info

# -------------------------------- DATABASE ---------------------------------
# Either provide DATABASE_URL, or the discrete DB_* variables.
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/emp_tracking
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=emp_tracking
DB_USER=workforce_app
DB_PASSWORD=change-me
DB_POOL_SIZE=12

# ------------------------------- EMAIL / SMTP ------------------------------
# SMTP is required for email OTP delivery. OTP values are never logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Workforce
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_REPLY_TO=support@example.com

# ----------------------------- OTP CONFIGURATION ---------------------------
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ------------------------------ AUTHENTICATION -----------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=unused-placeholder-reserved-for-refresh-tokens
SESSION_SECRET=replace-with-another-long-random-string
COOKIE_SECRET=replace-with-another-long-random-string
SESSION_TTL_DAYS=7
INTERNAL_JOB_SECRET=replace-with-a-random-string

# --------------------------------- REDIS -----------------------------------
# Optional. Not required for a single-instance deployment (see MEMORY.md).
REDIS_URL=

# ------------------------------- WEBSOCKET ---------------------------------
# Leave empty to use the current origin (recommended).
WEBSOCKET_URL=

# ------------------------------ FILE STORAGE -------------------------------
# Local disk is the implemented provider. S3-compatible values are reserved.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=15

# ------------------------------ NOTIFICATIONS ------------------------------
# Reserved for Web Push (not enabled in this release).
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# ------------------------------ RATE LIMITING ------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=600
LOGIN_RATE_LIMIT_MAX=20

# ----------------------------- SMS OTP (optional) --------------------------
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
SMS_SENDER_ID=WORKFR

# ----------------------------- MEETINGS / WEBRTC ---------------------------
# Built-in WebRTC mesh is the implemented provider; TURN is required for
# restrictive networks. MEETING_* keys are reserved for external providers.
MEETING_PROVIDER=builtin
MEETING_API_KEY=
MEETING_API_SECRET=
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Web Push (VAPID) for the website / installed PWA: incoming-call ringing and chat alerts
# while the app is closed. Generate ONCE with: npx web-push generate-vapid-keys
# and never change them (a new key silently invalidates every phone's subscription).
# If empty, keys are generated into backend/storage/config/vapid.json, which must survive redeploys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Fail-closed upload scanning; private network only
CLAMAV_HOST=
CLAMAV_PORT=3310
# Set loopback only when NGINX runs on the same host
TRUST_PROXY=

# Default API binding is private to this host
BIND_HOST=127.0.0.1

# Website-managed installation (no sample business data)
WEB_SETUP_ENABLED=true
# Optional private directory; default backend/storage/config
# WORKFORCE_CONFIG_DIR=
# Optional 64-hex-character encryption key from a secret manager
# ENCRYPTION_MASTER_KEY=

# Demo login helper (development only; ignored in production)
TEST_LOGIN_ENABLED=true
TEST_LOGIN_PASSWORD=Workforce@2026

# Coarena Model API (server only; optional)
COARENA_API_KEY=
COARENA_MODEL=gpt-6-luna
COARENA_TIMEOUT_MS=60000

# Mobile app (Android / iOS)
# Firebase service account for push to phones (Firebase console > Project settings >
# Service accounts > Generate new private key). Server-side only; never put it in the app.
# Give either a file path or the JSON itself (raw or base64). Leave both empty to disable.
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=
# Origins the Capacitor app runs on. Allowed for Bearer-token requests without cookies only.
MOBILE_APP_ORIGINS=capacitor://localhost,https://localhost

# Activity tracking: path of the Windows agent installer served at /api/tracking/agent/download
# (default: tracking-agent/dist/BSC-Activity-Tracker-Setup.exe)
TRACKING_AGENT_INSTALLER=
